  <exercise>
    <introduction>
      <p>
        Evaluate the following integrals using Integration by Parts
      </p>
    </introduction>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{\ln x}{x^{2}}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{t}{e^{t}}\,dt}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{6x^2\ln x\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{3xe^{4x}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{2x^4\ln x\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{t^2e^{3t}\,dt}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{te^{2t}\,dt}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{x^3\ln x\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\theta\sin\theta\,d\theta}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\theta^2\sin\theta\,d\theta}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{x}{(x^{2}+2x+1)^{2}}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{x^3e^{x^2}\,dx}}</m>
        </p>
      </statement>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Evaluate the following integrals using Partial Fractions
      </p>
    </introduction>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{1}{z^{2}-5z+6}\,dz}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{x^{2}+2}{x^{2}-4}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{5}{x^{2}-x}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{r+10}{r^{2}-4}\,dr}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{e^{x}}{(e^{x}-1)(e^{x}+1)}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{x}{x^{2}+4x}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{y-1}{y^{2}-2y}\,dy}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{x}{x^{2}+4x+4}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{1}{x^{2}+x-6}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{1}{p^{2}-2p}\,dp}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{x^{2}}{(x+1)^{3}}\,dx}}</m>
        </p>
      </statement>
    </task>
  </exercise>





  <exercise>
    <introduction>
      <p>
        Challenging Problems
      </p>

      <p>
        Note: These problems require a combination of two methods or possibly
        tables.
      </p>
    </introduction>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\arctan w\,dw}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\cos^3\theta\sin^4\theta\,d\theta}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\cos^5\theta\sin^2\theta\,d\theta}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{5}{x^{2}-4x+11}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{6}{x^{2}-6x+11}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\arcsin y\,dy}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{e^{x}}{e^{2x}-1}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{1}{(\sqrt{1+x^2})^{3}}\,dx}}</m>
        </p>
      </statement>
    </task>
  </exercise>
