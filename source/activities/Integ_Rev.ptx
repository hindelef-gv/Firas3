
<worksheet xml:id="ws-0">
  <title>Integration Review</title>
<objectives> 

  <ul>
    <li>General/Basic Antiderivatives</li>
    <li>Integration by Substitution</li>
    <li>Integration by Parts</li>
    <li>Integration by Partial fractions</li>
    <li>Mixing all techniques</li>
  </ul>
</objectives>

<exercise>
  <introduction> <p>Evaluate the following integrals</p></introduction>
 <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{1}{\sqrt{x}}+x^{-\frac{5}{2}}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{e^{2t}-\cos(3t)+4-\frac{3}{t^{2}}\,dt}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\sin(-\pi t)+e^{\frac{t}{\pi}}+\frac{7}{t^{2}+1}\,dt}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\frac{x^{2}+x+1}{x}\,dx}}</m>
        </p>
      </statement>
    </task>

    <task>
      <statement>
        <p>
          <m>\displaystyle{\int{\sqrt{x}(x^2-\frac{1}{x})\,dx}}</m>
        </p>
      </statement>
    </task>

 
</exercise>
	
  
  
  
  
  
  <exercise>
    <introduction>
